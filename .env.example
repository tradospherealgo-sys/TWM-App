# ============================================================
# TRADOSPHERE WEALTH MANAGEMENT (TWM) - ENVIRONMENT CONFIGURATION
# ============================================================

# ------------------------------------------------------------
# 1. BOOTSTRAP / DEPLOYMENT SECRETS (MANDATORY AT STARTUP)
# These MUST remain deployment-level environment variables because
# the server and database require them BEFORE the application boots.
# They CANNOT be managed from the Admin UI.
# ------------------------------------------------------------

# [REQUIRED - PRODUCTION & DEV] Database Connection URL
# Local Dev Default: "file:./dev.db" (SQLite)
# Production: "postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?pgbouncer=true"
DATABASE_URL="file:./dev.db"

# [REQUIRED - PRODUCTION & DEV] Authentication & Session Master Secret (Min 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET="twm_development_session_secret_change_in_production_min_32_chars!"

# [OPTIONAL / RECOMMENDED - PRODUCTION] Master Credential Encryption Key (Min 32 characters)
# Used to encrypt third-party credentials entered in Admin -> Integrations using AES-256-GCM.
# If unset, automatically derives from JWT_SECRET.
INTEGRATION_ENCRYPTION_KEY="twm_production_master_encryption_key_change_in_production_32b!"

# [REQUIRED - PRODUCTION & DEV] Application URL & Environment
NEXT_PUBLIC_APP_NAME="Tradosphere Wealth Management"
NEXT_PUBLIC_APP_SHORT_NAME="TWM"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development" # Set to "production" in live deployment

# ------------------------------------------------------------
# 2. RUNTIME THIRD-PARTY INTEGRATIONS (MANAGED VIA ADMIN -> INTEGRATIONS)
# You DO NOT need to edit these manually in production!
# Manage, encrypt, test, and rotate all credentials securely from:
#   https://your-domain.com/admin/integrations
#
# Environment variables below serve as optional boot fallbacks only.
# ------------------------------------------------------------

# SMC Global Integration (Authorised Person / Brokerage Gateway)
# Managed in: Admin -> Integrations -> SMC Global
SMC_GLOBAL_AP_CODE=""
SMC_GLOBAL_API_KEY=""
SMC_GLOBAL_API_SECRET=""
SMC_GLOBAL_ONBOARDING_URL="https://www.smcindiaonline.com"
SMC_GLOBAL_TRADING_PORTAL_URL="https://smctradeonline.com"

# Upstox API v2 (Market Data Feed)
# Managed in: Admin -> Integrations -> Upstox
UPSTOX_CLIENT_ID=""
UPSTOX_CLIENT_SECRET=""
UPSTOX_ACCESS_TOKEN=""
UPSTOX_BASE_URL="https://api.upstox.com/v2"

# AI Employee Copilot & Knowledge Assistant
# Managed in: Admin -> Integrations -> AI Provider
AI_PROVIDER_API_KEY=""
AI_PROVIDER_MODEL="gemini-1.5-flash"

# Document & Storage Vault
# Managed in: Admin -> Integrations -> Document Storage
STORAGE_DRIVER="local" # 'local' | 's3' | 'supabase' | 'r2'
STORAGE_BUCKET_NAME=""

# Transactional Email Service
# Managed in: Admin -> Integrations -> Email
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="no-reply@tradosphere.in"

# Notifications Subsystem
# Managed in: Admin -> Integrations -> Notifications
NOTIFICATION_MODE="IN_APP_ONLY" # 'IN_APP_ONLY' | 'IN_APP_EMAIL' | 'IN_APP_SMS'
