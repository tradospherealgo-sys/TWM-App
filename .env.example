# ============================================================
# TRADOSPHERE WEALTH MANAGEMENT (TWM) - ENVIRONMENT CONFIGURATION
# ============================================================

# Application
NEXT_PUBLIC_APP_NAME="Tradosphere Wealth Management"
NEXT_PUBLIC_APP_SHORT_NAME="TWM"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (Default: SQLite for zero-credential local dev, PostgreSQL in production)
DATABASE_URL="file:./dev.db"

# Authentication & Session Security (Minimum 32-character random string)
# Generate with: openssl rand -base64 32
JWT_SECRET="twm_development_session_secret_change_in_production_min_32_chars!"

# ------------------------------------------------------------
# INTEGRATIONS (Optional / Provided when credentials available)
# When unset or empty, TWM displays honest "Configuration Required" states.
# Never fabricate simulated trades or fake pricing!
# ------------------------------------------------------------

# SMC Global Integration (Authorised Person / Brokerage)
SMC_GLOBAL_AP_CODE=""
SMC_GLOBAL_API_KEY=""
SMC_GLOBAL_API_SECRET=""
SMC_GLOBAL_ONBOARDING_URL="https://www.smcindiaonline.com"
SMC_GLOBAL_TRADING_PORTAL_URL="https://smctradeonline.com"

# Market Data Provider (NSE/BSE Data Feed)
MARKET_DATA_PROVIDER_URL=""
MARKET_DATA_PROVIDER_API_KEY=""

# AI Employee Copilot & Knowledge Assistant
AI_PROVIDER_API_KEY=""
AI_PROVIDER_MODEL="gemini-1.5-flash"

# Document & Storage Management
STORAGE_DRIVER="local" # 'local' | 's3' | 'gcs'
STORAGE_BUCKET_NAME=""

# Notifications (SMS / Email)
NOTIFICATION_PROVIDER="disabled" # 'disabled' | 'smtp' | 'sms_gateway'
